{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.7.0"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "npm run hooks:install && next dev",
    "build": "next build --webpack",
    "benchmark:bundle": "node scripts/benchmark-bundle.ts",
    "benchmark:sidebar": "vitest bench --run src/lib/wiki-indexes.bench.ts",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "wrangler deploy",
    "start": "next start",
    "lint": "npm --prefix .. run lint -- frontend",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:api": "openapi-ts && node scripts/patch-generated.ts && node scripts/format-generated.ts",
    "typecheck": "next typegen && tsrs --noEmit",
    "typegen": "next typegen",
    "check:dependencies": "syncpack lint",
    "knip": "knip",
    "type-coverage": "type-coverage --strict --at-least 99 --ignore-files \"src/components/ui/**\"",
    "hooks:install": "cd .. && sh scripts/github/install-hooks.sh",
    "patches:apply": "patch-package --error-on-fail",
    "test": "node --test --test-timeout=10000 scripts/*.test.ts && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "npm run patches:apply && npm run generate:api && npm run hooks:install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@tanstack/react-query": "^5.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emoji-mart": "^5.6.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@sarj/eslint-plugin": "19.0.1",
    "@sarj/tsconfig": "0.2.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@taplo/cli": "^0.7.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "braces": "3.0.3",
    "eslint-plugin-zod": "5.2.2",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.1",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "patch-package": "8.0.1",
    "postcss": "^8.5.32",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "type-coverage": "^2.31.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "4.158.0",
    "syncpack": "15.3.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "@oxlint/plugins": "1.91.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "parse5": "8.0.0",
    "oxlint-plugin-eslint": "1.91.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "@emoji-mart/react": {
      "react": "$react"
    },
    "fast-uri": "^3.1.9",
    "js-yaml@>=5.0.0 <5.5.0": "5.5.0",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "markdownlint@0.42.0": {
      "re2js": "2.9.1"
    },
    "postcss": "^8.5.32",
    "smol-toml@>=1.0.0 <1.9.1": "1.9.1",
    "micromark-extension-math": {
      "katex": "0.19.1"
    },
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
    "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
    "undici@>=6.5.0 <6.29.1": "6.29.1",
    "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.7",
    "ip-address@>=10.0.0 <10.7.5": "10.7.5",
    "undici@>=7.0.0 <7.30.2": "7.30.2",
    "body-parser@>=2.0.0 <2.4.0": "2.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true,
    "lefthook@2.2.2": true,
    "workerd@1.20261104.1": true
  },
  "type": "module"
}
