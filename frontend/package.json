{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.7.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "npm run hooks:install && next dev",
    "build": "next build --webpack",
    "benchmark:bundle": "node scripts/benchmark-bundle.ts",
    "benchmark:sidebar": "vitest bench --run src/lib/wiki-indexes.bench.ts",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "wrangler deploy",
    "start": "next start",
    "lint": "next typegen && eslint --suppressions-location eslint-suppressions.json",
    "lint:baseline-check": "node scripts/check-eslint-baseline.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-ts && node scripts/patch-generated.ts && prettier --write src/lib/generated",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "next typegen",
    "knip": "knip",
    "type-coverage": "type-coverage --strict --at-least 99 --ignore-files \"src/components/ui/**\"",
    "hooks:install": "cd .. && sh scripts/github/install-hooks.sh",
    "patches:apply": "patch-package --error-on-fail",
    "test": "node --test --test-timeout=10000 scripts/*.test.ts && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "npm run patches:apply && npm run generate:api && npm run hooks:install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emoji-mart": "^5.6.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@sarj/eslint-plugin": "16.21.1",
    "@sarj/tsconfig": "0.2.0",
    "@shadcn/lint": "0.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@taplo/cli": "^0.7.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "braces": "3.0.3",
    "eslint": "10.12.0",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-node-test": "1.0.1",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jsdoc": "65.3.1",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "78.0.0",
    "eslint-plugin-zod": "5.0.1",
    "happy-dom": "^20.11.2",
    "jiti": "2.7.0",
    "knip": "^6.32.2",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "patch-package": "8.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "0.9.18",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "type-coverage": "^2.30.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.123.0",
    "eslint-plugin-regexp": "3.3.1"
  },
  "overrides": {
    "eslint-plugin-jest": "$eslint-plugin-jest",
    "@emoji-mart/react": {
      "react": "$react"
    },
    "@hono/node-server": "^2.0.12",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.7",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "10.12.0"
    },
    "js-yaml": "^5.4.2",
    "markdownlint-cli2": {
      "smol-toml": "1.9.0"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.12"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@8.0.7": {
      "brace-expansion": "^2.1.7"
    },
    "nanoid": "3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "smol-toml@>=1.0.0 <1.9.0": "1.9.0",
    "micromark-extension-math": {
      "katex": "0.18.2"
    },
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
    "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
    "undici@>=7.0.0 <7.29.1": "7.29.1",
    "@modelcontextprotocol/sdk@>=1.12.0 <1.31.0": "1.31.0",
    "ip-address@>=10.0.0 <10.7.1": "10.7.2",
    "markdown-it@>=14.0.0 <14.3.1": "14.3.2",
    "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "fsevents@2.3.3": true,
    "lefthook@2.1.10": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260811.1": true
  },
  "type": "module"
}
