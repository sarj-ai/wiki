{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.7.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "npm run hooks:install && next dev",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "wrangler deploy",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings 0 --suppressions-location eslint-suppressions.json",
    "lint:baseline-check": "node scripts/check-eslint-baseline.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-ts && node scripts/patch-generated.mjs && prettier --write src/lib/generated",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "next typegen",
    "knip": "knip",
    "type-coverage": "type-coverage --strict --at-least 99 --ignore-files \"src/components/ui/**\"",
    "hooks:install": "cd .. && lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "npm run generate:api && npm run hooks:install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emoji-mart": "^5.6.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/compat": "2.1.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@sarj/eslint-plugin": "15.13.2",
    "@sarj/tsconfig": "0.1.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@taplo/cli": "^0.7.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-plugin-zod": "4.9.1",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.2",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "type-coverage": "^2.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0",
    "react-doctor": "0.9.12"
  },
  "overrides": {
    "@emoji-mart/react": {
      "react": "$react"
    },
    "@hono/node-server": "^2.0.12",
    "fast-uri": "^3.1.5",
    "hono": "^4.13.2",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "10.8.1"
    },
    "js-yaml": "^5.2.2",
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.8"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.17"
    },
    "minimatch@8.0.7": {
      "brace-expansion": "^2.1.3"
    },
    "nanoid": "3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "fsevents@2.3.3": true,
    "lefthook@2.1.10": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260811.1": true
  }
}
