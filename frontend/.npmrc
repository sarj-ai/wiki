min-release-age-exclude[]=@typescript-eslint/utils
min-release-age-exclude[]=@typescript-eslint/visitor-keys
# Standards 8.8 requires these exact ESLint peers; remove after
# 2026-10-08T07:33:00Z, once every release passes the 14-day age gate.
min-release-age-exclude[]=@shadcn/lint
min-release-age-exclude[]=cn
min-release-age-exclude[]=eslint-plugin-perfectionist
legacy-peer-deps=true
save-exact=true
strict-allow-scripts=true
# GHSA-r4xh-jqrq-34v2: exact 1.9.0 fix; remove after 2026-10-06T17:15:35Z.
min-release-age-exclude[]=smol-toml
# GHSA-68fv-2mgg-jv7q: exact 1.2.2 fix; remove after 2026-10-14T14:08:10Z.
min-release-age-exclude[]=source-map-js
# GHSA-6qxp-vccf-f47h: exact SDK 1.31.0 fix; remove after 2026-10-12T18:59:36Z.
min-release-age-exclude[]=@modelcontextprotocol/sdk

