# Temporary until 2026-09-13T20:02:00Z; package.json pins every Jest-plugin edge.
min-release-age-exclude[]=eslint-plugin-jest
# Standards 7.15.7 requires ESLint 10.10.0; remove these after 2026-09-18,
# once both releases pass the 14-day age gate.
min-release-age-exclude[]=eslint
min-release-age-exclude[]=@eslint/plugin-kit
min-release-age-exclude[]=@sarj/eslint-plugin
min-release-age-exclude[]=@sarj/tsconfig
# The current Sarj ESLint bundle deliberately tracks this exact parser family.
min-release-age-exclude[]=typescript-eslint
min-release-age-exclude[]=@typescript-eslint/eslint-plugin
min-release-age-exclude[]=@typescript-eslint/parser
min-release-age-exclude[]=@typescript-eslint/project-service
