# Temporary until 2026-09-13T20:02:00Z; package.json pins every Jest-plugin edge.
min-release-age-exclude[]=eslint-plugin-jest
# Standards 7.15.7 requires ESLint 10.10.0; remove these after 2026-09-18,
# once both releases pass the 14-day age gate.
min-release-age-exclude[]=eslint
min-release-age-exclude[]=@eslint/plugin-kit
min-release-age-exclude[]=@sarj/eslint-plugin
min-release-age-exclude[]=@sarj/tsconfig
# The current Sarj ESLint bundle deliberately tracks this exact parser family.
min-release-age-exclude[]=typescript-eslint
min-release-age-exclude[]=@typescript-eslint/eslint-plugin
min-release-age-exclude[]=@typescript-eslint/parser
min-release-age-exclude[]=@typescript-eslint/project-service
min-release-age-exclude[]=@typescript-eslint/scope-manager
min-release-age-exclude[]=@typescript-eslint/tsconfig-utils
min-release-age-exclude[]=@typescript-eslint/type-utils
min-release-age-exclude[]=@typescript-eslint/types
min-release-age-exclude[]=@typescript-eslint/typescript-estree
min-release-age-exclude[]=@typescript-eslint/utils
min-release-age-exclude[]=@typescript-eslint/visitor-keys
# Standards 8.8 requires these exact ESLint peers; remove after
# 2026-10-08T07:33:00Z, once every release passes the 14-day age gate.
min-release-age-exclude[]=@shadcn/lint
min-release-age-exclude[]=cn
min-release-age-exclude[]=eslint-plugin-perfectionist
legacy-peer-deps=true
save-exact=true
strict-allow-scripts=true
