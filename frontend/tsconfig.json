{
  "extends": "@sarj/tsconfig/strict.json",
  "compilerOptions": {
    "isolatedDeclarations": false,

    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "ES2025"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.cts"
  ],
  "exclude": ["node_modules"]
}
