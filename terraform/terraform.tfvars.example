project_id     = "sarj-docs"
dammam_region  = "me-central2"
frontend_url   = "https://wiki.sarj.ai"
backend_domain = "api-wiki.sarj.ai"
db_tier        = "db-f1-micro"

# Google OAuth credentials — create at console.cloud.google.com
# under APIs & Services → Credentials → OAuth 2.0 Client IDs.
google_client_id     = "<oauth-client-id>"
google_client_secret = "<oauth-client-secret>"

# Fernet key for encrypting per-user OAuth tokens at rest in Postgres.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
fernet_key = "<fernet-key>"
cache_fernet_key = "<newest-cache-fernet-key>,<previous-cache-fernet-key>"

# Native MCP remains disabled. In a separately reviewed provisioning apply, set
# this true and supply both independent keys. Keep the lock key stable across
# credential-ring rotation. The merge/default plan provisions nothing.
provision_mcp_native_secrets = false
# mcp_native_fernet_keys = "<newest-mcp-fernet-key>,<previous-mcp-fernet-key>"
# mcp_native_lock_key    = "<stable-independent-mcp-lock-key>"

alert_email = "alerts@sarj.ai"
