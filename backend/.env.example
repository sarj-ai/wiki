# DB_INSTANCE_CONNECTION_NAME=sarj-docs:me-central1:instance-name
# DB_IAM_USER=
# DB_NAME=sarj_wiki
SECRET_KEY=change-me-to-a-random-secret-of-32-chars-or-more
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
FERNET_KEY=
# CACHE_FERNET_KEY=  # Comma-separated, newest first
ALLOWED_DOMAIN=sarj.ai
FRONTEND_URL=http://localhost:3000
# COOKIE_DOMAIN=  # HTTPS only; must contain both frontend and OAuth callback hosts
LOG_JSON=false
LOG_LEVEL=INFO
MAINTENANCE_MODE=false
# API_DOCS_ENABLED=false
# MCP_NATIVE_ENABLED=false
# MCP_NATIVE_ISSUER=  # Fixed HTTPS API origin; never derive from request headers
# MCP_NATIVE_FERNET_KEYS=  # Separate secret-managed ring, newest first
# MCP_NATIVE_LOCK_KEY=  # Independent stable key; do not rotate with the ring
# MCP_NATIVE_LOOPBACK_PATHS=[]  # Only exact verified Codex callback paths
# MCP_NATIVE_HTTPS_CALLBACKS=[]  # Optional exact administrator-approved callbacks
# RELEASE_SHA=dev
# SIDEBAR_CACHE_TTL=PT10M
# GOOGLE_CLOUD_PROJECT=
# GEMINI_LOCATION=global
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_REORGANIZATION_MODEL=gemini-3.5-flash
# DOCUMENT_TRANSFORM_UNSLOP_MODEL=gemini-3.1-flash-lite
# DOCUMENT_TRANSFORM_FALLBACK_MODEL=gemini-2.5-flash-lite
# DOCUMENT_TRANSFORM_RESTYLE_MODEL=gemini-3.8-flash
# DOCUMENT_TRANSFORM_LOGO_URI=https://wiki.sarj.ai/brand/sarj-logo-light.png
