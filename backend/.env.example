# DOCUMENT_TRANSFORM_QA_AUDIENCE=  # Exact backend OIDC audience
# DOCUMENT_TRANSFORM_QA_IMAGE_DIGEST=  # Exact sha256:<64 lowercase hex> digest
# DOCUMENT_TRANSFORM_QA_SERVICE_ACCOUNT=  # Dedicated Cloud Run QA workload service-account email
# Launcher profile: configure the base profile plus every field below; no partial/mixed profile is valid.
# DOCUMENT_TRANSFORM_QA_BOOTSTRAP_URL=  # Exact internal bootstrap URL
# DOCUMENT_TRANSFORM_QA_JOB=  # Fully qualified projects/.../locations/.../jobs/... resource
# DOCUMENT_TRANSFORM_QA_IMAGE=  # Exact Artifact Registry image URI pinned by the base digest
# DOCUMENT_TRANSFORM_QA_RELEASE_SHA=  # Exact 40-character source revision represented by the QA image
# DOCUMENT_TRANSFORM_QA_BACKEND_SERVICE_ACCOUNT=  # Backend identity allowed to create and attest executions
# DOCUMENT_TRANSFORM_QA_CORPUS_SOURCE_FOLDER_ID=  # Exact Security folder eligible for read-only corpus planning
