  "cases": [
    {
      "id": "round10-ux-01",
      "label": "Reload landing page: recent-pages loading waterfall",
      "judgeEngine": "agy",
      "originalFrameCount": 4,
      "findings": [
        {
          "id": "UX-FINDING-01",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-recent-cache",
          "reason": "Source confirms per-mount metadata state resets; controlled warm tests justify cache reuse. The recording cannot establish 7.4 seconds of network latency."
        },
        {
          "id": "UX-FINDING-02",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-sidebar-loading",
          "reason": "The raw pending sidebar gives little progress feedback. Later recordings show all drives and bounded successful drive reads; an indefinite failure is unproven."
        },
        {
          "id": "UX-FINDING-03",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-recent-skeleton",
          "reason": "The one-line placeholder grows into a multi-row list. Reserving recent-row skeleton space addresses the observed jump."
        },
        {
          "id": "UX-FINDING-04",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-recent-label",
          "reason": "The last-five accessible label describes four rendered authorized links. A count-neutral name describes the list accurately."
        },
        {
          "id": "UX-FINDING-05",
          "classification": "not-defect",
          "reason": "An initials fallback while the avatar image loads is intentional; the clip provides no controlled browser-cache failure or broken avatar evidence."
        }
      ],
      "hypothesisCount": 0
    },
    {
      "id": "round10-ux-02",
      "label": "Open the authorized canary and return home",
      "judgeEngine": "agy",
      "originalFrameCount": 4,
      "findings": [
        {
          "id": "round10-ux-02-breadcrumb-current-page",
          "classification": "not-defect",
          "reason": "The viewer deliberately omits a duplicate leaf title for Docs/Sheets/Slides/Drawings because the embedded editor owns that title; other file kinds include a leaf."
        },
        {
          "id": "round10-ux-02-sidebar-truncation-ambiguity",
          "classification": "not-defect",
          "reason": "Full text remains in the accessible name and native title. The recording shows a narrow presentation, without an incorrect label or failed item selection."
        }
      ],
      "hypothesisCount": 0
    },
    {
      "id": "round10-ux-03",
      "label": "Direct canary load, document toolbar and viewer",
      "judgeEngine": "agy",
      "originalFrameCount": 3,
      "findings": [
        {
          "id": "round10-ux-03-sidebar-loading-continuity",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-sidebar-loading",
          "reason": "Cold document startup renders a plain pending sidebar before its tree; a stable skeleton makes that state useful."
        }
      ],
      "hypothesisCount": 0
    },
    {
      "id": "round10-ux-04",
      "label": "Switch canaries and verify browser back/forward",
      "judgeEngine": "agy",
      "originalFrameCount": 3,
      "findings": [
        {
          "id": "round10-ux-04-breadcrumb-static-root",
          "classification": "not-defect",
          "reason": "The same embedded-title breadcrumb policy applies during history; route, selection and viewer title are consistent."
        },
        {
          "id": "round10-ux-04-sidebar-item-action-linger",
          "classification": "not-defect",
          "reason": "Row actions intentionally remain visible for hover/focus-within. Clearing another row focus on history would interrupt keyboard navigation."
        }
      ],
      "hypothesisCount": 0
    },
    {
      "id": "round10-ux-05",
      "label": "Collapsed drive expansion and reopen",
      "judgeEngine": "agy",
      "originalFrameCount": 5,
      "findings": [
        {
          "id": "round10-ux-05-drive-action-button-density",
          "classification": "unproven-hypothesis",
          "reason": "The small targets are a design candidate, but the recorded actions work and do not overlap; no incorrect collapse/misclick was demonstrated. Existing sibling actions stop propagation."
        },
        {
          "id": "round10-ux-05-async-expansion-a11y-tree-instability",
          "classification": "unproven-hypothesis",
          "reason": "Pixel frames and stable drive keys show distinct rows. A changing native AX diff alone does not prove incorrect rendered hierarchy."
        }
      ],
      "hypothesisCount": 0
    },
    {
      "id": "round10-ux-06",
