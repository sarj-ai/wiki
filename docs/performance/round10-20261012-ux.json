    {
      "id": "round10-ux-08",
      "label": "Sidebar pointer resize and keyboard support",
      "judgeEngine": "agy",
      "originalFrameCount": 6,
      "findings": [
        {
          "id": "round10-ux-08-f01",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-resize",
          "reason": "The pointer miss is recorded beside a four-pixel rail. A wider target keeps the thin visual divider and the existing drag selection suppression."
        },
        {
          "id": "round10-ux-08-f02",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-resize",
          "reason": "The splitter is skipped by keyboard Tab. Focusable range semantics and native bounded key handling address this, with real outer-pane geometry."
        }
      ],
      "hypothesisCount": 0
    },
    {
      "id": "round10-ux-09",
      "label": "Mobile sidebar open, Escape, backdrop, and canary navigation",
      "judgeEngine": "agy",
      "originalFrameCount": 7,
      "findings": [
        {
          "id": "round10-ux-09-f01",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-mobile-navigation",
          "reason": "A successful document link changes the route while the drawer blocks its content. The repair closes accepted same-route navigation or the matching committed target."
        },
        {
          "id": "round10-ux-09-f02",
          "classification": "confirmed-defect",
          "repairId": "round10-ux-fix-focus-return",
          "reason": "Stored rendered BODY focus after dismissal confirms loss of the visible mobile opener. The shared owner-fenced fallback restores it."
        },
        {
          "id": "round10-ux-09-f03",
          "classification": "unproven-hypothesis",
          "reason": "The captures are close to the500ms opening animation and later frames show the full drawer. A settled reopen/transform check remains a live follow-up."
        }
      ],
      "hypothesisCount": 0
    },
    {
      "id": "round10-ux-10",
      "label": "Mobile document toolbar accessible action labels and safe dialog dismissal",
